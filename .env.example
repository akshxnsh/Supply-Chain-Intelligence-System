# Copy to .env and fill in. .env is gitignored - never commit real values.

# PostgreSQL (Neon in production, local Docker for dev/tests)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# Test database (tests that need a real Postgres skip when this is unset)
TEST_DATABASE_URL=postgresql://postgres:PASSWORD@localhost:55432/chainguard

# Redis cache (reader cache and API response cache; both fall back to "no cache" if Redis is down)
REDIS_URL=redis://localhost:6379/0
# API_CACHE=0                      # 1 (default) = cache the read endpoints, 0 = off

# Gemini
GEMINI_API_KEY=
# Optional overrides (defaults live in src/agent/model_config.py; a model id containing "/" is sent to Groq, "gemini-..." to Google)
# READER_MODEL=gemini-3.5-flash-lite
# JUDGE_MODEL=openai/gpt-oss-120b
# CHAT_MODEL=gemini-3.5-flash-lite      # Ask ChainGuard
# READER_RPM=12                        # requests per minute you allow yourself (free tier limit is 15)
# JUDGE_RPM=4
# JUDGE_MAX_PER_RUN=10                 # only the biggest alerts per run go to the judge model

# Which businesses the scheduled pipeline analyses (comma separated; default demo-business-001)
# PIPELINE_BUSINESSES=demo-business-001

# IMF PortWatch daily traffic layers (optional; without it the traffic-trend signal is off)
PORTWATCH_ARCGIS_TOKEN=

# Groq (the judge: openai/gpt-oss-120b; free tier 30 req/min, 1,000/day, 8,000 tokens/min)
GROQ_API_KEY=

# Fivetran
FIVETRAN_API_KEY=
FIVETRAN_API_SECRET=

# Phoenix tracing (optional)
PHOENIX_API_KEY=
PHOENIX_COLLECTOR_ENDPOINT=
PHOENIX_PROJECT_NAME=supply-chain-agent
