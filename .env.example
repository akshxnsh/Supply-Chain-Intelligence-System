# Copy to .env and fill in. .env is gitignored - never commit real values.

# PostgreSQL (Neon in production, local Docker for dev/tests)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# Test database (tests that need a real Postgres skip when this is unset)
TEST_DATABASE_URL=postgresql://postgres:PASSWORD@localhost:55432/chainguard

# Redis cache (step 6 onwards)
REDIS_URL=redis://localhost:6379/0

# Gemini
GEMINI_API_KEY=
# Optional overrides (defaults live in src/agent/model_config.py)
# READER_MODEL=gemini-2.5-flash-lite
# JUDGE_MODEL=gemini-2.5-flash

# IMF PortWatch daily traffic layers (optional; without it the traffic-trend signal is off)
PORTWATCH_ARCGIS_TOKEN=

# Groq (the judge: openai/gpt-oss-120b; free tier 30 req/min, 1,000/day, 8,000 tokens/min)
GROQ_API_KEY=

# Fivetran
FIVETRAN_API_KEY=
FIVETRAN_API_SECRET=

# Phoenix tracing (optional)
PHOENIX_API_KEY=
PHOENIX_COLLECTOR_ENDPOINT=
PHOENIX_PROJECT_NAME=supply-chain-agent
